<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#40FFFFFF">
    <item>
        <shape android:shape="oval">
            <gradient
                android:angle="135"
                android:startColor="#7B2CBF"
                android:centerColor="#3A0CA3"
                android:endColor="#4CC9F0"
                android:type="linear" />
